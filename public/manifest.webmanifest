{
  "name": "AE Secure — Encrypted Messaging",
  "short_name": "AE Secure",
  "description": "Self-hosted, end-to-end encrypted messaging, communities, stories and cloud storage. All encryption happens on your device.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "browser"
  ],
  "orientation": "any",
  "background_color": "#0a0b0b",
  "theme_color": "#0a0b0b",
  "categories": [
    "social",
    "productivity",
    "utilities"
  ],
  "lang": "en",
  "dir": "ltr",
  "icons": [
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Messages",
      "url": "/?app=messages"
    },
    {
      "name": "Drive",
      "url": "/?app=drive"
    },
    {
      "name": "Settings",
      "url": "/?app=settings"
    }
  ]
}
